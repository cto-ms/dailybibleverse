# ─────────── Sanity ───────────
SANITY_PROJECT_ID=hx1r1wkd
SANITY_DATASET=production
SANITY_API_VERSION=2024-10-01
SANITY_WRITE_TOKEN=sk_replace_me

# ─────────── GCS ───────────
GCS_BUCKET=truepresence-bible
# Either GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/sa.json
# or paste the JSON directly into GCS_SERVICE_ACCOUNT_JSON (single line).
GOOGLE_APPLICATION_CREDENTIALS=
GCS_SERVICE_ACCOUNT_JSON=

# Public base URL for reading translation JSON in the runtime resolver.
# If the bucket is public, use https://storage.googleapis.com/truepresence-bible
GCS_PUBLIC_BASE=https://storage.googleapis.com/truepresence-bible

# ─────────── Anthropic ───────────
ANTHROPIC_API_KEY=sk-ant-replace_me
ANTHROPIC_MODEL=claude-opus-4-6

# ─────────── HelloAO BSB API ───────────
HELLOAO_BASE=https://bible.helloao.org/api

# ─────────── Runtime server ───────────
PORT=8080
DEFAULT_TRANSLATION=bsb
